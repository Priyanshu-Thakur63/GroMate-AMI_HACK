enum AirQualityCategory {
  GOOD
  MODERATE
  UNHEALTHY_SENSITIVE
  UNHEALTHY
  VERY_UNHEALTHY
  HAZARDOUS
}

model AirQuality {
  id         String             @id @default(uuid())
  zoneId     String?
  zone       Zone?              @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  latitude   Float
  longitude  Float
  aqi        Int // Air Quality Index (0 - 500)
  pm2_5      Float?
  pm10       Float?
  no2        Float?
  o3         Float?
  co         Float?
  so2        Float?
  category   AirQualityCategory @default(MODERATE)
  recordedAt DateTime           @default(now())
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @default(now()) @updatedAt
}

enum DisasterType {
  FLOOD
  EARTHQUAKE
  CYCLONE
  WILDFIRE
  LANDSLIDE
  CHEMICAL_SPILL
  HEATWAVE
  OTHER
}

enum DisasterStatus {
  ACTIVE
  CONTAINED
  RESOLVED
}

model Disaster {
  id               String         @id @default(uuid())
  zoneId           String?
  zone             Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  title            String
  disasterType     DisasterType   @default(OTHER)
  severity         SeverityLevel  @default(HIGH)
  status           DisasterStatus @default(ACTIVE)
  description      String
  instructions     String? // Safety/evacuation guidance
  affectedRadiusKm Float          @default(5.0)
  latitude         Float
  longitude        Float
  declaredAt       DateTime       @default(now())
  endedAt          DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
}

enum IncidentCategory {
  WATERLOGGING
  POWER_OUTAGE
  FALLEN_TREE
  TRAFFIC_JAM
  ROAD_DAMAGE
  FIRE
  GAS_LEAK
  STRUCTURAL_COLLAPSE
  OTHER
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model IncidentReport {
  id              String           @id @default(uuid())
  zoneId          String?
  zone            Zone?            @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  title           String
  description     String
  category        IncidentCategory @default(OTHER)
  severity        SeverityLevel    @default(MEDIUM)
  status          IncidentStatus   @default(OPEN)
  address         String?
  latitude        Float
  longitude       Float
  reporterName    String?
  reporterContact String?
  reportedAt      DateTime         @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt
}

model CivicObservation {
  id               String   @id @default(uuid())
  source           String // e.g. "OPEN_METEO_WEATHER", "OPEN_METEO_AQ", "JAIPUR_INCIDENT", "GNEWS"
  category         String // "WEATHER", "AIR_QUALITY", "INCIDENT", "SENTIMENT", "DISASTER"
  metricType       String // "TEMPERATURE", "RAINFALL", "PM25", "AQI", "INCIDENT_EVENT", "PUBLIC_TONE"
  value            Float
  unit             String // "celsius", "mm", "ug/m3", "score", "level_1_to_5"
  severity         String   @default("NORMAL") // "NORMAL", "MODERATE", "ELEVATED", "CRITICAL"
  latitude         Float
  longitude        Float
  observedAt       DateTime
  ingestedAt       DateTime @default(now())
  freshnessSeconds Int      @default(0)
  metadata         Json?

  zoneId    String
  zone      Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([category, metricType, observedAt])
  @@index([zoneId, observedAt])
}

model AnomalyLog {
  id         String   @id @default(uuid())
  zoneId     String
  zone       Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  metricType String // "RAINFALL_SPIKE", "AQI_HAZARD", "INCIDENT_CLUSTER", "SENTIMENT_PLUNGE"
  severity   String // "MODERATE", "ELEVATED", "CRITICAL"
  deviationZ Float // Calculated Z-score
  message    String
  detectedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([zoneId, detectedAt])
}

model CorrelationLog {
  id         String   @id @default(uuid())
  zoneId     String
  zone       Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  title      String
  summary    String // Plain language AI explanation
  confidence Float // 0.0 to 1.0
  sources    Json // Array of involved source categories/IDs
  detectedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([zoneId, detectedAt])
}

model PulseScoreLog {
  id                  String   @id @default(uuid())
  zoneId              String
  zone                Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  overallScore        Float // 0 to 100
  environmentalScore  Float // 0 to 100
  infrastructureScore Float // 0 to 100
  sentimentScore      Float // 0 to 100
  disasterImpactScore Float // 0 to 100
  summaryText         String?
  generatedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SentimentLabel {
  POSITIVE
  NEUTRAL
  NEGATIVE
  URGENT
}

model SocialSentiment {
  id             String         @id @default(uuid())
  zoneId         String?
  zone           Zone?          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  platform       String         @default("Civic Feed")
  content        String
  sentimentScore Float // -1.0 to +1.0
  sentimentLabel SentimentLabel @default(NEUTRAL)
  keywords       String[]       @default([])
  latitude       Float?
  longitude      Float?
  postedAt       DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
}

model WeatherData {
  id            String   @id @default(uuid())
  zoneId        String?
  zone          Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  latitude      Float
  longitude     Float
  temperature   Float // Celsius
  humidity      Float // Percentage
  precipitation Float // mm
  windSpeed     Float // km/h
  condition     String // e.g. "Heavy Rain", "Clear", "Thunderstorm"
  weatherCode   Int?
  alert         String? // e.g. "Flash Flood Warning"
  recordedAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model Zone {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  city      String   @default("Jaipur")
  state     String   @default("Rajasthan")
  latitude  Float
  longitude Float
  radiusKm  Float    @default(5.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  weatherData      WeatherData[]
  incidentReports  IncidentReport[]
  airQualityData   AirQuality[]
  socialSentiments SocialSentiment[]
  disasters        Disaster[]
  pulseScores      PulseScoreLog[]
  observations     CivicObservation[]
  anomalies        AnomalyLog[]
  correlations     CorrelationLog[]
}
