enum AirQualityCategory {
  GOOD
  MODERATE
  UNHEALTHY_SENSITIVE
  UNHEALTHY
  VERY_UNHEALTHY
  HAZARDOUS
}

model AirQuality {
  id          String             @id @default(uuid())
  zoneId      String?
  zone        Zone?              @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  latitude    Float
  longitude   Float
  aqi         Int                // Air Quality Index (0 - 500)
  pm2_5       Float?
  pm10        Float?
  no2         Float?
  o3          Float?
  co          Float?
  so2         Float?
  category    AirQualityCategory @default(MODERATE)
  recordedAt  DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
}
